    {
      "path": "registry/blocks/just-for-fun/guitar-string/guitar-string.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Guitar String</title>\n  <style>\n    :root {\n      --bg-primary: #f7f7f7;\n      --bg-secondary: #ececec;\n      --text-primary: #1a1a1a;\n      --text-secondary: #666666;\n      --border-color: #d7d7d7;\n      --accent-color: #2563eb;\n      --string-color: #111111;\n    }\n\n    :root[data-theme=\"dark\"],\n    html[data-theme=\"dark\"] {\n      --bg-primary: #0f0f10;\n      --bg-secondary: #1b1b1d;\n      --text-primary: #f5f5f5;\n      --text-secondary: #a0a0a0;\n      --border-color: #2f2f33;\n      --accent-color: #60a5fa;\n      --string-color: #f5f5f5;\n    }\n\n    @media (prefers-color-scheme: dark) {\n      :root:not([data-theme=\"light\"]) {\n        --bg-primary: #0f0f10;\n        --bg-secondary: #1b1b1d;\n        --text-primary: #f5f5f5;\n        --text-secondary: #a0a0a0;\n        --border-color: #2f2f33;\n        --accent-color: #60a5fa;\n        --string-color: #f5f5f5;\n      }\n    }\n\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      width: 100%;\n      height: 100%;\n    }\n\n    body {\n      font-family: sans-serif;\n      display: grid;\n      place-items: center;\n      background: radial-gradient(circle at 20% 20%, var(--bg-secondary), var(--bg-primary));\n      color: var(--text-primary);\n      overflow: hidden;\n      padding: 2rem;\n    }\n\n    .string {\n      width: min(1000px, 100%);\n      height: 300px;\n      border: 1px solid var(--border-color);\n      border-radius: 1rem;\n      background: color-mix(in srgb, var(--bg-secondary) 70%, transparent);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: crosshair;\n      position: relative;\n    }\n\n    .label {\n      position: absolute;\n      top: 1.5rem;\n      left: 1rem;\n      font-size: 0.75rem;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n      color: var(--text-secondary);\n    }\n\n    svg {\n      width: min(1000px, 96%);\n      height: 180px;\n      overflow: visible;\n    }\n\n    path {\n      stroke: var(--string-color);\n      stroke-width: 2;\n      fill: transparent;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"string\">\n    <p class=\"label\">Drag across the string</p>\n    <svg viewBox=\"0 0 1000 300\" aria-label=\"Guitar string animation\">\n      <path d=\"M 10 100 Q 500 100 990 100\"></path>\n    </svg>\n  </div>\n\n  <script defer src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js\" integrity=\"sha512-NcZdtrT77bJr4STcmsGAESr06BYGE8woZdSdEgqnpyqac7sugNO+Tr4bGwGF3MsnEkGKhU2KL2xh6Ec+BqsaHA==\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\"></script>\n  <script>\n    window.addEventListener(\"DOMContentLoaded\", () => {\n      let path = \"M 10 100 Q 500 100 990 100\";\n      const finalPath = \"M 10 100 Q 500 100 990 100\";\n      const string = document.querySelector(\".string\");\n\n      string.addEventListener(\"mousemove\", (event) => {\n        const bounds = string.getBoundingClientRect();\n        const x = ((event.clientX - bounds.left) / bounds.width) * 1000;\n        const y = ((event.clientY - bounds.top) / bounds.height) * 300;\n\n        path = `M 10 100 Q ${x} ${y} 990 100`;\n\n        gsap.to(\"svg path\", {\n          attr: { d: path },\n          duration: 0.3,\n          ease: \"power3.out\",\n        });\n      });\n\n      string.addEventListener(\"mouseleave\", () => {\n        gsap.to(\"svg path\", {\n          attr: { d: finalPath },\n          duration: 1.5,\n          ease: \"elastic.out(1,0.2)\",\n        });\n      });\n    });\n  </script>\n</body>\n</html>\n",
      "type": "registry:block"
    }
  ]
}