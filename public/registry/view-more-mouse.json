  "files": [
    {
      "path": "registry/blocks/hover-animations/view-more-mouse/view-more-mouse.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>View More Mouse</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      --bg-primary: #f6f6f6;\n      --bg-secondary: #ededed;\n      --text-primary: #1a1a1a;\n      --text-secondary: #5f5f5f;\n      --border-color: #d8d8d8;\n      --accent-color: #3b82f6;\n      --cursor-bg: #ffffff;\n      --cursor-hover-bg: #ffffff8a;\n      --cursor-text: #111111;\n      --image-shadow: #00000033;\n    }\n\n    :root[data-theme=\"dark\"],\n    html[data-theme=\"dark\"] {\n      --bg-primary: #0f0f10;\n      --bg-secondary: #1a1a1c;\n      --text-primary: #f5f5f5;\n      --text-secondary: #a0a0a0;\n      --border-color: #313136;\n      --accent-color: #60a5fa;\n      --cursor-bg: #f5f5f5;\n      --cursor-hover-bg: #f5f5f58a;\n      --cursor-text: #111111;\n      --image-shadow: #00000052;\n    }\n\n    @media (prefers-color-scheme: dark) {\n      :root:not([data-theme=\"light\"]) {\n        --bg-primary: #0f0f10;\n        --bg-secondary: #1a1a1c;\n        --text-primary: #f5f5f5;\n        --text-secondary: #a0a0a0;\n        --border-color: #313136;\n        --accent-color: #60a5fa;\n        --cursor-bg: #f5f5f5;\n        --cursor-hover-bg: #f5f5f5;\n        --cursor-text: #111111;\n        --image-shadow: #00000052;\n      }\n    }\n\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    html,\n    body {\n      width: 100%;\n      height: 100%;\n    }\n\n    body {\n      font-family: \"DM Sans\", sans-serif;\n      background: var(--bg-primary);\n      color: var(--text-primary);\n      overflow: hidden;\n    }\n\n    .main {\n      width: 100%;\n      height: 100%;\n      background: radial-gradient(circle at 25% 20%, var(--bg-secondary), var(--bg-primary));\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      padding: 2rem;\n    }\n\n    .cursor {\n      width: 20px;\n      height: 20px;\n      background: var(--cursor-bg);\n      color: var(--cursor-text);\n      border-radius: 9999px;\n      position: fixed;\n      font-size: 0.25rem;\n      font-weight: 450;\n      letter-spacing: 0.03em;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      text-align: center;\n      z-index: 99;\n      pointer-events: none;\n      transform: translate(-50%, -50%);\n      text-transform: uppercase;\n    }\n\n    .image {\n      width: min(40vw, 540px);\n      height: min(62vw, 400px);\n      position: relative;\n      border-radius: 1rem;\n      overflow: hidden;\n      border: 1px solid var(--border-color);\n      box-shadow: 0 20px 60px var(--image-shadow);\n    }\n\n    .image img {\n      height: 100%;\n      width: 100%;\n      object-fit: cover;\n      display: block;\n    }\n\n    .overlay {\n      background: transparent;\n      height: 100%;\n      width: 100%;\n      position: absolute;\n      inset: 0;\n      z-index: 10;\n    }\n\n    @media (max-width: 768px) {\n      .image {\n        width: 92vw;\n        height: 58vw;\n      }\n    }\n  </style>\n</head>\n\n<body>\n  <div class=\"cursor\"></div>\n\n  <div class=\"main\">\n    <div class=\"image\">\n      <div class=\"overlay\"></div>\n      <img src=\"/assets/stock/Solitude Amidst Grandeur.png\" alt=\"Landscape preview\" />\n    </div>\n  </div>\n\n  <script defer src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js\"\n    integrity=\"sha512-NcZdtrT77bJr4STcmsGAESr06BYGE8woZdSdEgqnpyqac7sugNO+Tr4bGwGF3MsnEkGKhU2KL2xh6Ec+BqsaHA==\"\n    crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\"></script>\n  <script>\n    window.addEventListener(\"DOMContentLoaded\", () => {\n      const main = document.querySelector(\".main\");\n      const cursor = document.querySelector(\".cursor\");\n      const imageDiv = document.querySelector(\".image\");\n\n      main.addEventListener(\"mousemove\", (event) => {\n        gsap.to(cursor, {\n          x: event.clientX,\n          y: event.clientY,\n          duration: 0.45,\n          ease: \"power3.out\",\n        });\n      });\n\n      imageDiv.addEventListener(\"mouseenter\", () => {\n        cursor.textContent = \"VIEW MORE\";\n        gsap.to(cursor, {\n          scale: 4,\n          backgroundColor: \"var(--cursor-hover-bg)\",\n          duration: 0.25,\n          ease: \"power2.out\",\n        });\n      });\n\n      imageDiv.addEventListener(\"mouseleave\", () => {\n        cursor.textContent = \"\";\n        gsap.to(cursor, {\n          scale: 1,\n          backgroundColor: \"var(--cursor-bg)\",\n          duration: 0.25,\n          ease: \"power2.out\",\n        });\n      });\n    });\n  </script>\n</body>\n\n</html>",
      "type": "registry:block"
    }
  ]
}